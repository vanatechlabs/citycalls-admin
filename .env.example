# CityCalls Admin — local development (runs on http://localhost:3000)
# Production: set the same keys in Coolify (NEXT_PUBLIC_* are baked in at build time).

# Backend API (citycalls-api). Production: https://api.citycalls.in/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Public website domain — used for SEO canonical URLs and "view page" links.
# Keep this the LIVE domain even locally, or canonicals saved from admin will point at localhost.
NEXT_PUBLIC_WEBSITE_URL=https://citycalls.in

# Website to open for previews (Launch Spotlight). Production: https://citycalls.in
NEXT_PUBLIC_CITYCALLS_WEBSITE_URL=http://localhost:3001
